<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usrig_presets</name>
  <version>0.1.0</version>
  <description>Preset collection mode: waypoint teach / verify, Stage 1 path editor, Stage 2 plan generator and the
    failure catalog, and preset_check (commanded moves with the pose change reported). Motion goes through
    robot_control; episodes through episode_manager.</description>
  <maintainer email="shivarajpanishettar01@gmail.com">Shivaraj Panishettar</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>usrig_interfaces</exec_depend>
  <exec_depend>usrig_common</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
