<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usrig_robot_cpp</name>
  <version>0.1.0</version>
  <description>robot_state in C++: lossless RTDE reading (ur_client_library) at 500 Hz.</description>
  <maintainer email="shivarajpanishettar01@gmail.com">Shivaraj Panishettar</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>usrig_interfaces</depend>
  <!-- ros-humble-ur-client-library; if missing, the package builds nothing and the Python
       robot_state is used (robot.launch.py falls back). -->
  <depend>ur_client_library</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
